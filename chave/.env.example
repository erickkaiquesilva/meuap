# Copy this file to .env.mock / .env.staging / .env.production
# and fill in the real values. NEVER commit real values.
#
# Staging (npm run dev:staging) — MSW desligado; aponta para chave-api local:
#   VITE_ENV=staging
#   VITE_API_URL=http://localhost:3001
# Mock (npm run dev / dev:mock) — MSW ligado; deixe VITE_API_URL vazio.

VITE_ENV=mock
# Root URL of the backend — without trailing slash and WITHOUT /api prefix
# (e.g. https://api.chave.com.br or http://localhost:3001). Leave empty for mock/dev
VITE_API_URL=
VITE_WA_NUMBER=44999999999
# Google Maps JavaScript API key (Maps JavaScript API enabled).
# Restrict by HTTP referrer in Google Cloud Console. Leave empty to use the CSS mock map.
VITE_GOOGLE_MAPS_API_KEY=
# Enable Maps JavaScript API + Geocoding API on this key (restrict by HTTP referrer).
# Google Identity Services — OAuth 2.0 Web client ID (public, not a server secret).
# Leave empty to sign in with the mock Conta Google button.
VITE_GOOGLE_CLIENT_ID=
